# Environment Configuration

# Server Port
PORT=3000

# MongoDB Connection URI
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/impersonation-detector

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/impersonation-detector?retryWrites=true&w=majority

# Node Environment
NODE_ENV=development

# Optional: API Key for future authentication
# API_KEY=your-secret-api-key-here
